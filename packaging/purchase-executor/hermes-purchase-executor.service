# Restricted Purchase Executor V0 — PRODUCTION unit (Hermes issue #65).
#
# Installed by packaging/purchase-executor/install.sh (sudo). Inert until Cal
# stages payment credentials with `systemd-creds encrypt` into
# /etc/credstore.encrypted and explicitly launches it via launch.sh.
#
# Dynamic ticket: the execution ticket is short-lived and per-purchase, so it is
# NOT a persistent encrypted credential. launch.sh writes it to a root-only
# tmpfs file under /run that this unit reads with LoadCredential= at start, then
# shreds it. It never lands on disk, in argv, in the environment, or in logs.
#
# hermes-gateway never loads any of these credentials (separate user + unit).

[Unit]
Description=Hermes Restricted Purchase Executor V0 (one-shot, single ticket)

[Service]
Type=oneshot
Restart=no
User=hermes-purchase-executor
Group=hermes-purchase-executor
WorkingDirectory=/home/v0id/.hermes/hermes-agent
Environment="HOME=/var/lib/hermes-purchase-executor"
Environment="HERMES_HOME=/etc/hermes-purchase-executor"
Environment="PLAYWRIGHT_BROWSERS_PATH=/home/v0id/.cache/ms-playwright"
EnvironmentFile=/etc/hermes-purchase-executor/executor.env
ExecStart=/home/v0id/.hermes/hermes-agent/venv/bin/python -m purchase_executor --bridge-url ${COGITATOR_BRIDGE_URL} --state-dir /var/lib/hermes-purchase-executor

# Persistent payment instrument + bridge token: encrypted at rest, visible only
# to this unit via $CREDENTIALS_DIRECTORY. Never exported to the environment.
LoadCredentialEncrypted=card_number:/etc/credstore.encrypted/card_number.cred
LoadCredentialEncrypted=card_expiry:/etc/credstore.encrypted/card_expiry.cred
LoadCredentialEncrypted=card_cvv:/etc/credstore.encrypted/card_cvv.cred
LoadCredentialEncrypted=card_name:/etc/credstore.encrypted/card_name.cred
LoadCredentialEncrypted=cogitator_bridge_token:/etc/credstore.encrypted/cogitator_bridge_token.cred
# Dynamic, per-run ticket: root-only tmpfs file written by launch.sh, removed
# immediately after start. NOT LoadCredentialEncrypted, NOT under /etc.
LoadCredential=ticket_token:/run/hermes-purchase-executor/ticket_token

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=hermes-purchase-executor
StateDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes
TimeoutStartSec=300
TimeoutStopSec=30
